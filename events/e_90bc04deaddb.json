WZEp1OEMxUHFhR1FIQ0pjU2d1NXYyd2M5eGRtdXdRRTRXd0lRcXhPT3NlOTFaNTBaSmFrWUoxQUhUVExhTEhQaEJKMUpNWlFCTFE0V245Zw?oc=5","p":"San Bernardino Sun","d":"2026-10-15T16:01:31Z","o":false,"dup":true}],"related":[],"revisions":[],"entities":[{"name":"North Korea","kind":"place","mentions":12},{"name":"KCNA","kind":"organisation","mentions":2},{"name":"Seoul","kind":"place","mentions":1},{"name":"South Korea","kind":"place","mentions":1},{"name":"US Allies","kind":"organisation","mentions":1}],"disputes":[],"summary":null,"context":{"background":[{"title":"North Korea and weapons of mass destruction","extract":"North Korea has the world's smallest stockpile of nuclear weapons, with an estimated 60 warheads and production of fissile material for six to seven warheads per year. North Korea is the tenth country to develop and most recent to openly test nuclear weapons. North Korea is also believed to have one of the world's largest chemical weapons stockpiles. North Korea is party to the Biological Weapons Convention, one of four United Nations members not to ratify the Chemical Weapons Convention, and the only country to announce withdrawal from the Non-Proliferation Treaty (NPT).","url":"https://en.wikipedia.org/wiki/North_Korea_and_weapons_of_mass_destruction","source":"Wikipedia","license":"CC BY-SA 4.0"}],"places":[{"title":"North Korea","extract":"North Korea, officially the Democratic People's Republic of Korea (DPRK), is a country in East Asia. It constitutes the northern half of the Korean Peninsula and borders China and Russia to the north at the Yalu (Amnok) and Tumen rivers, and South Korea to the south at the Korean Demilitarized Zone (DMZ). The country's western border is formed by the Yellow Sea, while its eastern border is defined by the Sea of Japan. Pyongyang is the capital and largest city.","url":"https://en.wikipedia.org/wiki/North_Korea","source":"Wikipedia","license":"CC BY-SA 4.0","iso2":"KP"},{"title":"South Korea","extract":"South Korea, officially the Republic of Korea (ROK), is a country in East Asia. It constitutes the southern half of the Korean Peninsula and borders North Korea along the Korean Demilitarized Zone, with the Yellow Sea to the west and the Sea of Japan to the east. South Korea claims to be the sole legitimate government of the entire peninsula and adjacent islands. It has a population of about 52 million, of which half live in the Seoul metropolitan area, the ninth most populous metropolitan area in the world, with other major cities being Busan, Daegu, and Incheon.","url":"https://en.wikipedia.org/wiki/South_Korea","source":"Wikipedia","license":"CC BY-SA 4.0","iso2":"KR"}],"arc":{"reports":27,"first_seen":"2026-10-12T01:54:19Z","first_title":"North Korea fires multiple ballistic missiles, adding to streak of weapons tests","first_url":"https://news.google.?oc=5","first_publisher":"Al Jazeera","earlier":[{"id":"e_b46f0ac8b5ee","title":"How North Korea’s cruise missile tests could ‘complicate’ regional defence","date":"2026-10-16T00:02:32Z","url":"https://news.google.?oc=5","publisher":"South China Morning Post","verification":"single_source_report"},{"id":"e_e405fa55326d","title":"North Korea Missile Chief Questions South Korea Hypersonic Glide Vehicle Test","date":"2026-10-16T00:41:00Z","url":"https://news.google.com/rss/articles/CBMiywFBVV95cUxPc1FWS28xVjVKZHdwSXpPMU9TNzFLclQwSUxKQ1hVNXRJWkFFclhOUHBXX3dHSmpzS2taZVVleWIxRV9tcTA3b1drTXhqMHoxcjU0VHFsZGNiTzI4Q0x3NzYyR2pPVHJOQWlqV3F5VFp6WlFsZWZiWFpocmdXRVdUa1dXMXgwa0xlRlVyN1JTcklTaHI0NkJjSEhseTVjNjFSQ0lZY253OWdkcHJBQzFrb0R0UmNsZ3ZtLWhzMW5lWVNXZEdRMFozTWNicw?oc=5","publisher":"U.S. News & World Report","verification":"multi_source_reporting"},{"id":"e_83e159c3a2da","title":"What do North Korea’s sub missile tests really prove?","date":"2026-10-16T03:19:45Z","url":"https://news.google.com/rss/articles/CBMiigFBVV95cUxOWTdRSkdNMkhQQlJFaDBWLWRwQjVZQUhqOHRha2lTR3lkYUg0Vk5FaU9KSGUtbXBaVloxeVpyR01jWmFfaU9SeWJURnpqNVBaSG04alZ5dlpqZWdYRHVKa0VfeUJEUUVlTGVTWGJMa0