mary":null,"context":{"background":[],"places":[{"title":"Nigeria","extract":"Nigeria, officially the Federal Republic of Nigeria, is a country in West Africa between the Sahel to the north and the Gulf of Guinea in the Atlantic Ocean to the south. It covers an area of 923,769 square kilometres (356,669 mi2). With a population of more than 242 million, it is the most populous country in Africa, and the world's sixth-most populous country. Nigeria borders Niger in the north, Chad in the northeast, Cameroon in the east, and Benin in the west. Nigeria is a federal republic comprising 36 states and the Federal Capital Territory, where its capital, Abuja, is located. The largest city in Nigeria by population is Lagos, one of the largest metropolitan areas in the world and the second largest in Africa.","url":"https://en.wikipedia.org/wiki/Nigeria","source":"Wikipedia","license":"CC BY-SA 4.0","iso2":"NG"}],"arc":{"reports":2,"first_seen":"2026-10-16T07:31:11Z","first_title":"New owner of British oil giant Shell’s Nigerian onshore business lines up $4.1 billion in contractor financing with 13 banks","first_url":"https://news.google.?oc=5","first_publisher":"Business Insider Africa","earlier":[{"id":"e_aea9f11cb24f","title":"New owner of British oil giant Shell’s Nigerian onshore business lines up $4.1 billion in contractor financing with 13 banks","date":"2026-10-16T07:31:11Z","url":"https://news.google.?oc=5","publisher":"Business Insider Africa","verification":"single_source_report"},{"id":"e_5869669471ec","title":"Watch Eyesan: Strong Interest in New Nigerian Oil Blocks","date":"2026-11-03T08:26:36Z","url":"https://news.google.com/rss/articles/CBMipwFBVV95cUxONUNocGQyRFViRjFkSGdha0JvMXJxQXNHZTFqaHRqcTAteTBSelMxNGRKZ292c3VBd0tGRERRNXl1SjlIODN0MGJrZHE2NF9teVpnQi1DVld3T3FTQlJiSk1nRkQwNGh2VmxDMkgzam9DSnJJb3VpczlEczR0SHVCZ2R4eTFlUnpUTzB2RDMzSFJQSTZRY0ZjZlB0dlhOWElHVHRHUVZ5dw?oc=5","publisher":"Bloomberg.com","verification":"single_source_report"}],"weekly":[["2026-10-12",1]