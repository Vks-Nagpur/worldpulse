se,"dup":true}],"related":[],"revisions":[],"entities":[{"name":"Russia","kind":"place","mentions":11},{"name":"Ukraine","kind":"place","mentions":11},{"name":"Trump","kind":"organisation","mentions":8},{"name":"Trump","kind":"person","mentions":1},{"name":"Zelenskiy","kind":"organisation","mentions":1},{"name":"Zelensky","kind":"person","mentions":1},{"name":"Zelenskyy","kind":"organisation","mentions":1},{"name":"Zelenskyy","kind":"person","mentions":1}],"disputes":[],"summary":null,"context":{"background":[{"title":"2022 Russian invasion of Ukraine","extract":"On 24 February 2022, during the Russo-Ukrainian war, Russia launched a full-scale invasion of Ukraine, starting the current phase of the war, the largest conflict in Europe since World War II. By April 2022, the invasion's initial goal of a rapid Russian victory via decapitation had failed, with Ukraine pushing back the northern arm of the invasion and preventing the capture of Kyiv. Following this, the war transitioned to more conventional fighting in the south and east of Ukraine.","url":"https://en.wikipedia.org/wiki/2022_Russian_invasion_of_Ukraine","source":"Wikipedia","license":"CC BY-SA 4.0"}],"places":[{"title":"Ukraine","extract":"Ukraine is a country in Eastern Europe. It is the second-largest country in Europe after Russia, which borders it to the east and northeast. Ukraine also borders Belarus to the north; Poland and Slovakia to the west; Hungary, Romania and Moldova to the southwest; and the Black Sea and the Sea of Azov to the south and southeast. Kyiv is Ukraine's capital and largest city, followed by Kharkiv, Odesa, and Dnipro. The official language is Ukrainian. Ukraine covers about 600,000 km2 (230,000 sq mi), with around 32 million people.","url":"https://en.wikipedia.org/wiki/Ukraine","source":"Wikipedia","license":"CC BY-SA 4.0","iso2":"UA"},{"title":"United States","extract":"The United States of America (USA), also known as the United States (U.S.) or America, is a country primarily located in North America. It is a federal republic consisting of 50 states and a federal capital district, Washington, D.C. The 48 contiguous states border Canada to the north and Mexico to the south, with the semi-exclave of Alaska in the northwest and the archipelago of Hawaii in the Pacific Ocean. The United States also asserts sovereignty over five major island territories and various uninhabited islands in Oceania and the Caribbean. It is a megadiverse country, with the world's fourth-largest total area and third-largest population, exceeding 341 million.","url":"https://en.wikipedia.org/wiki/United_States","source":"Wikipedia","license":"CC BY-SA 4.0","iso2":"US"}],"arc":{"reports":113,"first_seen":"2026-10-10T12:13:37Z","first_title":"Watch: 'Time for Ukraine to get a new president', says Trump","first_url":"https://www.aljazeera.com/news/2026/10/12/trump-thinks-ukraine-needs-a-new-president-who-could-replace-zelenskyy?traffic_source=rss","first_publisher":"Al Jazeera English","earlier":[{"id":"e_e70f14e0ebfc","title":"Trump calls for end to Russia - Ukraine war amid Zelenskyy warning against trusting Putin","date":"2026-10-16T22:30:00Z","url":"http://www.batonrougepost.com/news/279380111/trump-calls-for-end-to-russia-ukraine-war-amid-zelenskyy-warning-against-trusting-putin","publisher":"batonrougepost.com","verification":"single_source_report"},{"id":"e_3c0cc7444f0b","title":"Zelensky Warns of More Trump - Russia Deals as Putin Envoy Eyes Expansion","date":"2026-10-16T22:30:00Z","url":"https://www.newsweek.com/zelensky-trump-russia-deals-putin-dmitriev-sanctions-12580951","publisher":"newsweek.com","verification":"single_source_report"},{"id":"e_2150749af0f8","title":"Trump Waives New Sanctions Against Russia","date":"2026-10-17T00:37:31Z","url":"https://news.google.?oc=5","publisher":"India Today","verification":"multi_source_reporting"},{"id":"e_0ce670216a56","title":"Ukraine War, Day 1,696: Trump Refuses To Implement New Russia Sanctions","date":"2026-1